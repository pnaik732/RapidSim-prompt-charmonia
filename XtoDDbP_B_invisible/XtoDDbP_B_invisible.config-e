# "X(3872)" decays to D0 D0B pi0 decay PHSP, which is incorrect.
# Because X(3872) is JPC = 1++:
# a) the (D* D0B) (D0 D*B) must be S or D-wave and (D0 pi0) (D0B pi0) are in P-Wave 
# b) the ([D0D0B] pi0)     must be in P-wave   and [D0 D0B] are in S or D-wave
# I could have used OMEGA_DALITZ, where (D* D0B) ([DD]pi0) (D0 D*B) are presumed P-Wave and the cascading (D0 D0B) (D0 pi0) (D0B pi0) are presumed P-Wave 
#  but it's still wrong

geometry : LHCb
acceptance : AllIn 
energy : 14   
parent : b
useEvtGen : TRUE
evtGenUsePHOTOS : TRUE
#paramsDecaying : M, M2, MT, E, ET, P, PX, PY, PZ, PT, IP, SIGMAIP, MINIP, SIGMAMINIP, FD, eta, phi, y, gamma, beta, theta, costheta, Mcorr, ProbNNpi, ProbNNk
#paramsStable : M, M2, MT, E, ET, P, PX, PY, PZ, PT, IP, SIGMAIP, MINIP, SIGMAMINIP, FD, eta, phi, y, gamma, beta, theta, costheta, Mcorr, ProbNNpi, ProbNNk
#paramsTwoBody : M, M2, MT, E, ET, P, PX, PY, PZ, PT, IP, SIGMAIP, MINIP, SIGMAMINIP, FD, eta, phi, y, gamma, beta, theta, costheta, Mcorr, ProbNNpi, ProbNNk
paramsDecaying : M, M2, MT, E, ET, P, PX, PY, PZ, PT, IP, SIGMAIP, MINIP, SIGMAMINIP, FD, eta, phi, y, gamma, beta, Mcorr
paramsStable : MT, E, ET, P, PX, PY, PZ, PT, IP, SIGMAIP, MINIP, SIGMAMINIP, eta, phi, y, gamma, beta, ProbNNpi, ProbNNk
paramsTwoBody : M, M2, MT, E, ET, P, PX, PY, PZ, PT, IP, SIGMAIP, MINIP, SIGMAMINIP, FD, eta, phi, y, gamma, beta, Mcorr

# X(3872) decay helicity angles [not useful if you can't see the pi0]
#param : D0_pi0_costheta_REST_D0_D0B costheta 3 4 3 5
#param : pi0_D0B_costheta_REST_D0_pi0 costheta 4 5 3 4
#param : D0_D0B_costheta_REST_D0B_pi0 costheta 3 5 5 4
#param : D0_pi0_costheta_REST_D0_D0B_TRUE costheta 3 4 3 5 TRUE
#param : pi0_D0B_costheta_REST_D0_pi0_TRUE costheta 4 5 3 4 TRUE
#param : D0_D0B_costheta_REST_D0B_pi0_TRUE costheta 3 5 5 4 TRUE

# separate X(3872) from psi(3770) 
param : Km_D0B_costheta_REST_D0 costheta 6 5 6 7
param : Km_D0B_theta_REST_D0 theta 6 5 6 7
param : Kp_D0_costheta_REST_D0B costheta 10 3 10 11
param : Kp_D0_theta_REST_D0B theta 10 3 10 11
param : Km_D0B_costheta_REST_D0_TRUE costheta 6 5 6 7 TRUE
param : Km_D0B_theta_REST_D0_TRUE theta 6 5 6 7 TRUE
param : Kp_D0_costheta_REST_D0B_TRUE costheta 10 3 10 11 TRUE
param : Kp_D0_theta_REST_D0B_TRUE theta 10 3 10 11 TRUE

# DDbar angle in the X frame [not possible without the light neutral]
#param : D0_D0B_costheta_REST_X costheta 3 5 3 5 4
#param : D0_D0B_theta_REST_X theta 3 5 3 5 4
#param : D0_D0B_costheta_REST_X_TRUE costheta 3 5 3 5 4 TRUE
#param : D0_D0B_theta_REST_X_TRUE theta 3 5 3 5 4 TRUE

# real B helicity B -> X K [not possible without the light neutral]
#param : D0_bachKp_costheta_REST_X costheta 3 2 3 5 4
#param : D0_bachKp_theta_REST_X theta 3 2 3 5 4
#param : D0_bachKp_costheta_REST_X_TRUE costheta 3 2 3 5 4 TRUE
#param : D0_bachKp_theta_REST_X_TRUE theta 3 2 3 5 4 TRUE

# B helicity (to separate ?={X,psi} in B -> ? K )
param : D0_bachKp_costheta_REST_D0_D0B costheta 3 2 3 5
param : D0_bachKp_theta_REST_D0_D0B theta 3 2 3 5
param : D0_bachKp_costheta_REST_D0_D0B_TRUE costheta 3 2 3 5 TRUE
param : D0_bachKp_theta_REST_D0_D0B_TRUE theta 3 2 3 5 TRUE
        
# B+ -> {X_1(3872) -> {D0 -> K- pi+} {pi0 -> gamma gamma} {D0b -> K+ pi-}} K+

@0
    name : Bp
    evtGenModel : SVS
@1
	name : X_3872
	evtGenModel : PHSP
#	evtGenModel : OMEGA_DALITZ
@2
    name : bachKp
    smear : LHCbGeneric
    smear : LHCbGenericIP
@3
	name : D0
@4
	name : pi0
        invisible: true
@5
	name : D0B
@6
        name : Km
	smear : LHCbGeneric        
	smear : LHCbGenericIP        
@7
        name : pip
	smear : LHCbGeneric
	smear : LHCbGenericIP        
@8
        name : gamma_a
	smear : LHCbPhoton        
        invisible: true
@9
        name : gamma_b
	smear : LHCbPhoton
        invisible: true
@10
        name : Kp
	smear : LHCbGeneric        
	smear : LHCbGenericIP        
@11
        name : pim
	smear : LHCbGeneric
	smear : LHCbGenericIP        
