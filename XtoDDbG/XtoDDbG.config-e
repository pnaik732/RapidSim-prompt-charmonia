# Setup where "X(3872)" decays to D0 D0B gamma decay, where D0 and D0B are presumed to be in a relative S-Wave. 
# In this case, the spin part in covariant tensor formalism is g^munu, i.e. equivalent to PHSP. 
# However, for us *PHSP is incorrect*. Because X(3872) is JPC = 1++, D0 and D0B should be in a relative P-wave.

geometry : LHCb
acceptance : AllIn
energy : 14
parent : x
useEvtGen : TRUE
evtGenUsePHOTOS : TRUE
#paramsDecaying : M, M2, MT, E, ET, P, PX, PY, PZ, PT, IP, SIGMAIP, MINIP, SIGMAMINIP, FD, eta, phi, y, gamma, beta, theta, costheta, Mcorr, ProbNNpi, ProbN$
#paramsStable : M, M2, MT, E, ET, P, PX, PY, PZ, PT, IP, SIGMAIP, MINIP, SIGMAMINIP, FD, eta, phi, y, gamma, beta, theta, costheta, Mcorr, ProbNNpi, ProbNNk
#paramsTwoBody : M, M2, MT, E, ET, P, PX, PY, PZ, PT, IP, SIGMAIP, MINIP, SIGMAMINIP, FD, eta, phi, y, gamma, beta, theta, costheta, Mcorr, ProbNNpi, ProbNNk
paramsDecaying : M, M2, MT, E, ET, P, PX, PY, PZ, PT, IP, SIGMAIP, MINIP, SIGMAMINIP, FD, eta, phi, y, gamma, beta, Mcorr
paramsStable : MT, E, ET, P, PX, PY, PZ, PT, IP, SIGMAIP, MINIP, SIGMAMINIP, eta, phi, y, gamma, beta, ProbNNpi, ProbNNk
paramsTwoBody : M, M2, MT, E, ET, P, PX, PY, PZ, PT, IP, SIGMAIP, MINIP, SIGMAMINIP, FD, eta, phi, y, gamma, beta, Mcorr

# X(3872) decay helicity angles
param : D0_gamma_costheta_REST_D0_D0B costheta 1 2 1 3
param : gamma_D0B_costheta_REST_D0_gamma costheta 2 3 1 2
param : D0_D0B_costheta_REST_D0B_gamma costheta 1 3 3 2
param : D0_gamma_costheta_REST_D0_D0B_TRUE costheta 1 2 1 3 TRUE
param : gamma_D0B_costheta_REST_D0_gamma_TRUE costheta 2 3 1 2 TRUE
param : D0_D0B_costheta_REST_D0B_gamma_TRUE costheta 1 3 3 2 TRUE

# separate X(3872) from psi(3770)
param : Km_D0B_costheta_REST_D0 costheta 4 3 4 5
param : Km_D0B_theta_REST_D0 theta 4 3 4 5
param : Kp_D0_costheta_REST_D0B costheta 6 1 6 7                    
param : Kp_D0_theta_REST_D0B theta 6 1 6 7
param : Km_D0B_costheta_REST_D0_TRUE costheta 4 3 4 5 TRUE
param : Km_D0B_theta_REST_D0_TRUE theta 4 3 4 5 TRUE
param : Kp_D0_costheta_REST_D0B_TRUE costheta 6 1 6 7 TRUE
param : Kp_D0_theta_REST_D0B_TRUE theta 6 1 6 7 TRUE

# DDbar angle in the X frame (visible light neutral)
param : D0_D0B_costheta_REST_X costheta 3 2 3 2 4
param : D0_D0B_theta_REST_X theta 3 2 3 2 4
param : D0_D0B_costheta_REST_X_TRUE costheta 3 2 3 2 4 TRUE
param : D0_D0B_theta_REST_X_TRUE theta 3 2 3 2 4 TRUE

# DDbar angle in the X frame (visible light neutral)
param : D0_D0B_costheta_REST_X costheta 1 3 1 3 2
param : D0_D0B_theta_REST_X theta 1 3 1 3 2
param : D0_D0B_costheta_REST_X_TRUE costheta 1 3 1 3 2 TRUE
param : D0_D0B_theta_REST_X_TRUE theta 1 3 1 3 2 TRUE

# X_1(3872) -> {D0 -> K- pi+} gamma {D0b -> K+ pi-}

@0
	name : X_3872
	evtGenModel : PHSP
@1
	name : D0
@2
	name : gamma
	smear : LHCbPhoton
@3
	name : D0B
@4
        name : Km
	smear : LHCbGeneric        
	smear : LHCbGenericIP        
@5
        name : pip
	smear : LHCbGeneric
	smear : LHCbGenericIP        
@6
        name : Kp
	smear : LHCbGeneric        
	smear : LHCbGenericIP        
@7
        name : pim
	smear : LHCbGeneric
	smear : LHCbGenericIP        
