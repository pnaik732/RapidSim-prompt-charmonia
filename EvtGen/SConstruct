#env.Append(CXXFLAGS = ['-O3', '-Wall', '-Wextra', '-Werror', '-pedantic', '-std=c++11'])
env.Append(LIBPATH = ['/Users/pnaik/work/EvtGen/EvtGen/external/HepMC/lib', '/Users/pnaik/work/EvtGen/EvtGen/evtgen/lib'])
env.Append(LIBPATH = ['/Users/pnaik/work/EvtGen/EvtGen/external/HepMC/lib', '/Users/pnaik/work/EvtGen/EvtGen/evtgen/lib', '/sw/lib/gcc4.3/lib/x86_64'])
env.ParseConfig("root-config --libs --cflags --ldflags")
