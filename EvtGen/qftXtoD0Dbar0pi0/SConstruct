import os

env = Environment(ENV=os.environ)

#print env["CC"]
#print env["CXX"]

env.Append(CPPPATH = ['/Users/pnaik/work/qft/'])
env.Append(CXXFLAGS = ['-O3', '-Wall', '-Wextra', '-pedantic', '-std=c++14'])
#env.Append(CXXFLAGS = ['-O3', '-Wall', '-Wextra', '-Werror', '-pedantic', '-std=c++11'])
env.Append(LIBPATH = ['/Users/pnaik/work/qft/lib','/sw/lib/gcc4.3/lib/x86_64'])
env.ParseConfig("root-config --libs --cflags --ldflags")
env.Append(LIBS = ['qft++'])

#Export environment
Export('env')

#Run SConscript files
SConscript('SConscript')
