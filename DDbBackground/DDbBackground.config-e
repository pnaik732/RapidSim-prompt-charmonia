geometry : LHCb
acceptance : AllIn 
energy : 14   
parent : x
#paramsDecaying : M, M2, MT, E, ET, P, PX, PY, PZ, PT, IP, SIGMAIP, MINIP, SIGMAMINIP, FD, eta, phi, y, gamma, beta, theta, costheta, Mcorr, ProbNNpi, ProbNNk
#paramsStable : M, M2, MT, E, ET, P, PX, PY, PZ, PT, IP, SIGMAIP, MINIP, SIGMAMINIP, FD, eta, phi, y, gamma, beta, theta, costheta, Mcorr, ProbNNpi, ProbNNk
#paramsTwoBody : M, M2, MT, E, ET, P, PX, PY, PZ, PT, IP, SIGMAIP, MINIP, SIGMAMINIP, FD, eta, phi, y, gamma, beta, theta, costheta, Mcorr, ProbNNpi, ProbNNk
paramsDecaying : M, M2, MT, E, ET, P, PX, PY, PZ, PT, IP, SIGMAIP, MINIP, SIGMAMINIP, FD, eta, phi, y, gamma, beta, Mcorr
paramsStable : MT, E, ET, P, PX, PY, PZ, PT, IP, SIGMAIP, MINIP, SIGMAMINIP, eta, phi, y, gamma, beta, ProbNNpi, ProbNNk
paramsTwoBody : M, M2, MT, E, ET, P, PX, PY, PZ, PT, IP, SIGMAIP, MINIP, SIGMAMINIP, FD, eta, phi, y, gamma, beta, Mcorr

param : D0_D0B_M M 1 2
param : D0_D0B_M_TRUE M 1 2 TRUE
param : D0_D0B_M2 M2 1 2
param : D0_D0B_M2_TRUE M2 1 2 TRUE
param : D0_D0B_MT MT 1 2
param : D0_D0B_MT_TRUE MT 1 2 TRUE
param : D0_D0B_ET ET 1 2
param : D0_D0B_ET_TRUE ET 1 2 TRUE
param : D0_D0B_FD FD 1 2
param : D0_D0B_FD_TRUE FD 1 2 TRUE
param : D0_D0B_eta eta 1 2
param : D0_D0B_eta_TRUE eta 1 2 TRUE
param : D0_D0B_phi phi 1 2
param : D0_D0B_phi_TRUE phi 1 2 TRUE
param : D0_D0B_y y 1 2
param : D0_D0B_y_TRUE y 1 2 TRUE
param : D0_D0B_gamma gamma 1 2
param : D0_D0B_gamma_TRUE gamma 1 2 TRUE
param : D0_D0B_beta beta 1 2
param : D0_D0B_beta_TRUE beta 1 2 TRUE
param : D0_D0B_Mcorr Mcorr 1 2
param : D0_D0B_Mcorr_TRUE Mcorr 1 2 TRUE
        
param : Km_D0B_costheta_REST_D0 costheta 3 2 3 4
param : Km_D0B_theta_REST_D0 theta 3 2 3 4
param : Kp_D0_costheta_REST_D0B costheta 5 1 5 6
param : Kp_D0_theta_REST_D0B theta 5 1 5 6
param : Km_D0B_costheta_REST_D0_TRUE costheta 3 2 3 4 TRUE
param : Km_D0B_theta_REST_D0_TRUE theta 3 2 3 4 TRUE
param : Kp_D0_costheta_REST_D0B_TRUE costheta 5 1 5 6 TRUE
param : Kp_D0_theta_REST_D0B_TRUE theta 5 1 5 6 TRUE

#useEvtGen : TRUE
evtGenUsePHOTOS : TRUE
param: bkgmass M 1 2 
param: bkgmass_true M 1 2 TRUE
# Only generate background to just above the edge of where XtoDDbG PHSP could be. 
# This is also at roughly 4 times the width away from the psi(3770) mass. 
cut : bkgmass_true max 3.87966
#3.72966, made it a little less to be sure, but I don't think I actually need this line
cut : bkgmass_true min 3.72965
# I never figured out how shape works
#shape : /Users/pnaik/work/RapidSim/DDbBackground/FlatBackground.root M_DD bkgmass_true
# min width just put in for safety, but is probably not needed
minWidth : 0.0001

@0
	name : BKG
#	evtGenModel : PHSP
@1
	name : D0
@2
	name : D0B
@3
        name : Km
	smear : LHCbGeneric        
	smear : LHCbGenericIP
@4
        name : pip
	smear : LHCbGeneric
	smear : LHCbGenericIP
@5
        name : Kp
	smear : LHCbGeneric        
	smear : LHCbGenericIP
@6
        name : pim
	smear : LHCbGeneric
	smear : LHCbGenericIP
