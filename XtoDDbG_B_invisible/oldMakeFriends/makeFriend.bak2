#include "TROOT.h"
#include "TFile.h"
#include "TTree.h"
#include "TBrowser.h"
#include "TH1.h"
#include "TLorentzVector.h"
#include "TVector3.h"
#include "TString.h"
#include "TRandom.h"

void makeFriend(TString inFile, TString outFile)
{
    //read the Tree generated by tree1w and fill two histograms
    //note that we use "new" to create the TFile and TTree objects !
    //because we want to keep these objects alive when we leave this function.
    TFile *f = new TFile(inFile);
    TTree *t1 = (TTree*)f->Get("DecayTree");

    // create the second root file with a different tree
    TFile ff(outFile,"recreate");
    TTree *tf = new TTree("DecayTree_Friend","A friend Tree");

    // B variables

    Double_t B_confirm_D0_D0B_Kp_M, B_msq_miss_max, B_confirm_Mcorr, B_confirm_B_M_TRUE, B_confirm_B_E_TRUE, B_E_rec_B;
    Double_t DDbK_pT_B_dir, B_signed_m_miss_max;
    Double_t Bp_FD_CALC;
    Double_t DDbK_pT_K_dir; // The key: DDbK pT perpendicular to the K flight direction (see my notes 16 May 2020)
    Double_t DDb_pT_K_dir; // The key: DDb pT perpendicular to the K flight direction (see my notes 16 May 2020)

    tf->Branch("B_confirm_D0_D0B_Kp_M",&B_confirm_D0_D0B_Kp_M,"B_confirm_D0_D0B_Kp_M/D");
    tf->Branch("B_confirm_Mcorr",&B_confirm_Mcorr,"B_confirm_Mcorr/D");
    tf->Branch("B_msq_miss_max",&B_msq_miss_max,"B_msq_miss_max/D");
    tf->Branch("B_E_rec_B",&B_E_rec_B,"B_E_rec_B/D");
    tf->Branch("B_confirm_B_M_TRUE",&B_confirm_B_M_TRUE,"B_confirm_B_M_TRUE/D");
    tf->Branch("B_confirm_B_E_TRUE",&B_confirm_B_E_TRUE,"B_confirm_B_E_TRUE/D");
    tf->Branch("B_signed_m_miss_max",&B_signed_m_miss_max,"B_signed_m_miss_max/D");
    tf->Branch("DDbK_pT_B_dir",&DDbK_pT_B_dir,"DDbK_pT_B_dir/D"); // DDbK pT perpendicular to the B flight direction (true, with smearing)
    tf->Branch("Bp_FD_CALC",&Bp_FD_CALC,"Bp_FD_CALC/D");
    tf->Branch("DDbK_pT_K_dir",&DDbK_pT_K_dir,"DDbK_pT_K_dir/D"); // The key: DDbK pT perpendicular to the K flight direction (true, with smearing)
    tf->Branch("DDb_pT_K_dir", &DDb_pT_K_dir, "DDb_pT_K_dir/D");  // The key: DDb pT perpendicular to the K flight direction (true, with smearing)

    // X variables

    Double_t confirm_MCorr, confirm_MCorr_bar, max_confirm_Mcorr; // The pT-corrected X mass
    Double_t msq_miss_max, msq_miss_max_bar, min_msq_miss_max, msq_miss_max_avg, signed_m_miss_max_avg; // the max missing mass squared of the neutral
    Double_t theVariable; // min_msq_miss_max, again
    Double_t pT_D_dir, pT_D_dir_bar, max_pT_dir; // The key: DDb pT perpendicular to the D,Db flight directions (as simulated)
    Double_t D_pT_Db_dir, Db_pT_D_dir, D_max_pT_dir; // The key: Db,D pT perpendicular to the D,Db flight directions (as simulated)
    Double_t pT_D_dir_orig, pT_D_dir_bar_orig, max_pT_dir_orig; // The key: DDb pT perpendicular to the D,Db flight directions (true, with smearing)
    Double_t D_pT_Db_dir_orig, Db_pT_D_dir_orig, D_max_pT_dir_orig; // The key: Db,D pT perpendicular to the D,Db flight directions (true, with smearing)
    Double_t pT_D_dir_orig_0003, pT_D_dir_bar_orig_0003, max_pT_dir_orig_0003; // The key: DDb pT perpendicular to the D,Db flight directions (true, with smearing)
    Double_t pT_D_dir_orig_003, pT_D_dir_bar_orig_003, max_pT_dir_orig_003; // The key: DDb pT perpendicular to the D,Db flight directions (true, with smearing)
    Double_t pT_D_dir_orig_001, pT_D_dir_bar_orig_001, max_pT_dir_orig_001; // The key: DDb pT perpendicular to the D,Db flight directions (true, with smearing)
    Double_t pT_D_dir_orig_03, pT_D_dir_bar_orig_03, max_pT_dir_orig_03; // The key: DDb pT perpendicular to the D,Db flight directions (true, with smearing)
    Double_t pT_D_dir_orig_01, pT_D_dir_bar_orig_01, max_pT_dir_orig_01; // The key: DDb pT perpendicular to the D,Db flight directions (true, with smearing)
    Double_t E_rec_X, E_rec_X_bar; // reco energy of the X in the lab frame
    Double_t p_break_hypoG, p_break_hypoG_sq;
    Double_t p_break_hypoP, p_break_hypoP_sq;
    Double_t msq_miss_restX;
//    Double_t max_confirm_Mcorr_fuzz, max_pT_dir_fuzz; not used
    Double_t min_msq_miss_max_fuzz, theVariable_fuzz; // these are identical
    Double_t delDir, delDir_bar;
    Double_t delCosDir, delCosDir_bar;
    Double_t D0_FD_CALC, D0B_FD_CALC;

    tf->Branch("confirm_MCorr",&confirm_MCorr,"confirm_MCorr/D");
    tf->Branch("confirm_MCorr_bar",&confirm_MCorr_bar,"confirm_MCorr_bar/D");
    tf->Branch("max_confirm_Mcorr",&max_confirm_Mcorr,"max_confirm_Mcorr/D");

    tf->Branch("msq_miss_max",&msq_miss_max,"msq_miss_max/D");
    tf->Branch("msq_miss_max_bar",&msq_miss_max_bar,"msq_miss_max_bar/D");
    tf->Branch("min_msq_miss_max",&min_msq_miss_max,"min_msq_miss_max/D"); // min_{msq_miss_max}
    tf->Branch("theVariable",&theVariable,"theVariable/D"); // same as above
    tf->Branch("msq_miss_max_avg",&msq_miss_max_avg,"msq_miss_max_avg/D"); // (msq_miss_max + msq_miss_max_bar)/2
    tf->Branch("signed_m_miss_max_avg",&signed_m_miss_max_avg,"signed_m_miss_max_avg/D");
                                                                            
    tf->Branch("pT_D_dir",&pT_D_dir,"pT_D_dir/D"); // use the simulated D flight direction (i.e. with detector effects)
    tf->Branch("pT_D_dir_bar",&pT_D_dir_bar,"pT_D_dir_bar/D");
    tf->Branch("max_pT_dir",&max_pT_dir,"max_pT_dir/D");

    tf->Branch("D_pT_Db_dir",&D_pT_Db_dir,"D_pT_Db_dir/D"); // use the simulated D flight direction (i.e. with detector effects)
    tf->Branch("Db_pT_D_dir",&Db_pT_D_dir,"Db_pT_D_dir/D");
    tf->Branch("D_max_pT_dir",&D_max_pT_dir,"D_max_pT_dir/D");

    // 0.001
    tf->Branch("pT_D_dir_orig",&pT_D_dir_orig,"pT_D_dir_orig/D"); // original method applying an uncertainty to the true flight direction
    tf->Branch("pT_D_dir_bar_orig",&pT_D_dir_bar_orig,"pT_D_dir_bar_orig/D");
    tf->Branch("max_pT_dir_orig",&max_pT_dir_orig,"max_pT_dir_orig/D");

    tf->Branch("D_pT_Db_dir_orig",&D_pT_Db_dir_orig,"D_pT_Db_dir_orig/D"); // use the simulated D flight direction (i.e. with detector effects)
    tf->Branch("Db_pT_D_dir_orig",&Db_pT_D_dir_orig,"Db_pT_D_dir_orig/D");
    tf->Branch("D_max_pT_dir_orig",&D_max_pT_dir_orig,"D_max_pT_dir_orig/D");

    tf->Branch("pT_D_dir_orig_03",&pT_D_dir_orig_03,"pT_D_dir_orig_03/D"); // original method applying an uncertainty to the true flight direction
    tf->Branch("pT_D_dir_bar_orig_03",&pT_D_dir_bar_orig_03,"pT_D_dir_bar_orig_03/D");
    tf->Branch("max_pT_dir_orig_03",&max_pT_dir_orig_03,"max_pT_dir_orig_03/D");

    tf->Branch("pT_D_dir_orig_01",&pT_D_dir_orig_01,"pT_D_dir_orig_01/D"); // original method applying an uncertainty to the true flight direction
    tf->Branch("pT_D_dir_bar_orig_01",&pT_D_dir_bar_orig_01,"pT_D_dir_bar_orig_01/D");
    tf->Branch("max_pT_dir_orig_01",&max_pT_dir_orig_01,"max_pT_dir_orig_01/D");

    tf->Branch("pT_D_dir_orig_003",&pT_D_dir_orig_003,"pT_D_dir_orig_003/D"); // original method applying an uncertainty to the true flight direction
    tf->Branch("pT_D_dir_bar_orig_003",&pT_D_dir_bar_orig_003,"pT_D_dir_bar_orig_003/D");
    tf->Branch("max_pT_dir_orig_003",&max_pT_dir_orig_003,"max_pT_dir_orig_003/D");

    tf->Branch("pT_D_dir_orig_0003",&pT_D_dir_orig_0003,"pT_D_dir_orig_0003/D"); // original method applying an uncertainty to the true flight direction
    tf->Branch("pT_D_dir_bar_orig_0003",&pT_D_dir_bar_orig_0003,"pT_D_dir_bar_orig_0003/D");
    tf->Branch("max_pT_dir_orig_0003",&max_pT_dir_orig_0003,"max_pT_dir_orig_0003/D");

    tf->Branch("E_rec_X",&E_rec_X,"E_rec_X/D");
    tf->Branch("E_rec_X_bar",&E_rec_X_bar,"E_rec_X_bar/D");
    tf->Branch("p_break_hypoG",&p_break_hypoG,"p_break_hypoG/D");
    tf->Branch("p_break_hypoP",&p_break_hypoP,"p_break_hypoP/D");
    tf->Branch("p_break_hypoG_sq",&p_break_hypoG_sq,"p_break_hypoG_sq/D");
    tf->Branch("p_break_hypoP_sq",&p_break_hypoP_sq,"p_break_hypoP_sq/D");
    tf->Branch("msq_miss_restX",&msq_miss_restX,"msq_miss_restX/D");

    tf->Branch("min_msq_miss_max_fuzz",&min_msq_miss_max_fuzz,"min_msq_miss_max_fuzz/D"); // min_{msq_miss_max}
    tf->Branch("theVariable_fuzz",&theVariable_fuzz,"theVariable_fuzz/D"); // same as above
//    tf->Branch("max_confirm_Mcorr_fuzz",&max_confirm_Mcorr_fuzz,"max_confirm_Mcorr_fuzz/D"); // min_{msq_miss_max}
//    tf->Branch("max_pT_dir_fuzz",&max_pT_dir_fuzz,"max_pT_dir_fuzz/D"); // min_{msq_miss_max}

    tf->Branch("delDir",&delDir,"delDir/D");
    tf->Branch("delDir_bar",&delDir_bar,"delDir_bar/D");

    tf->Branch("delCosDir",&delCosDir,"delCosDir/D");
    tf->Branch("delCosDir_bar",&delCosDir_bar,"delCosDir_bar/D");

    tf->Branch("D0_FD_CALC",&D0_FD_CALC,"D0_FD_CALC/D");
    tf->Branch("D0B_FD_CALC",&D0B_FD_CALC,"D0B_FD_CALC/D");

    // B variables

    Double_t bachKp_PX;
    Double_t bachKp_PY;
    Double_t bachKp_PZ;
    Double_t bachKp_E;
    Double_t bachKp_PX_TRUE;
    Double_t bachKp_PY_TRUE;
    Double_t bachKp_PZ_TRUE;
    Double_t bachKp_E_TRUE;

    t1->SetBranchAddress("bachKp_PX",&bachKp_PX);
    t1->SetBranchAddress("bachKp_PY",&bachKp_PY);
    t1->SetBranchAddress("bachKp_PZ",&bachKp_PZ);
    t1->SetBranchAddress("bachKp_E",&bachKp_E);      
    t1->SetBranchAddress("bachKp_PX_TRUE",&bachKp_PX_TRUE);
    t1->SetBranchAddress("bachKp_PY_TRUE",&bachKp_PY_TRUE);
    t1->SetBranchAddress("bachKp_PZ_TRUE",&bachKp_PZ_TRUE);
    t1->SetBranchAddress("bachKp_E_TRUE",&bachKp_E_TRUE);      

    Double_t Bp_origX;
    Double_t Bp_origY;
    Double_t Bp_origZ;
    Double_t Bp_vtxX;
    Double_t Bp_vtxY;
    Double_t Bp_vtxZ;
    Double_t Bp_origX_TRUE;
    Double_t Bp_origY_TRUE;
    Double_t Bp_origZ_TRUE;
    Double_t Bp_vtxX_TRUE;
    Double_t Bp_vtxY_TRUE;
    Double_t Bp_vtxZ_TRUE;

    t1->SetBranchAddress("Bp_vtxX_TRUE",&Bp_vtxX_TRUE);
    t1->SetBranchAddress("Bp_vtxY_TRUE",&Bp_vtxY_TRUE);
    t1->SetBranchAddress("Bp_vtxZ_TRUE",&Bp_vtxZ_TRUE);
    t1->SetBranchAddress("Bp_origX_TRUE",&Bp_origX_TRUE);
    t1->SetBranchAddress("Bp_origY_TRUE",&Bp_origY_TRUE);
    t1->SetBranchAddress("Bp_origZ_TRUE",&Bp_origZ_TRUE);
    t1->SetBranchAddress("Bp_vtxX",&Bp_vtxX);
    t1->SetBranchAddress("Bp_vtxY",&Bp_vtxY);
    t1->SetBranchAddress("Bp_vtxZ",&Bp_vtxZ);
    t1->SetBranchAddress("Bp_origX",&Bp_origX);
    t1->SetBranchAddress("Bp_origY",&Bp_origY);
    t1->SetBranchAddress("Bp_origZ",&Bp_origZ);

    // D variables

    Double_t D0_PX;
    Double_t D0_PY;
    Double_t D0_PZ;
    Double_t D0_E;
    Double_t D0B_PX;
    Double_t D0B_PY;
    Double_t D0B_PZ;
    Double_t D0B_E;
//    Double_t gamma_PX;
//    Double_t gamma_PY;
//    Double_t gamma_PZ;
//    Double_t gamma_E;
    Double_t D0_PX_TRUE;
    Double_t D0_PY_TRUE;
    Double_t D0_PZ_TRUE;
    Double_t D0_E_TRUE;
    Double_t D0B_PX_TRUE;
    Double_t D0B_PY_TRUE;
    Double_t D0B_PZ_TRUE;
    Double_t D0B_E_TRUE;
    Double_t gamma_PX_TRUE;
    Double_t gamma_PY_TRUE;
    Double_t gamma_PZ_TRUE;
    Double_t gamma_E_TRUE;

    t1->SetBranchAddress("D0_PX",&D0_PX);
    t1->SetBranchAddress("D0_PY",&D0_PY);
    t1->SetBranchAddress("D0_PZ",&D0_PZ);
    t1->SetBranchAddress("D0_E",&D0_E);      
    t1->SetBranchAddress("D0B_PX",&D0B_PX);
    t1->SetBranchAddress("D0B_PY",&D0B_PY);
    t1->SetBranchAddress("D0B_PZ",&D0B_PZ);
    t1->SetBranchAddress("D0B_E",&D0B_E);
//    t1->SetBranchAddress("gamma_PX",&gamma_PX);
//    t1->SetBranchAddress("gamma_PY",&gamma_PY);
//    t1->SetBranchAddress("gamma_PZ",&gamma_PZ);
//    t1->SetBranchAddress("gamma_E",&gamma_E);
    t1->SetBranchAddress("D0_PX_TRUE",&D0_PX_TRUE);
    t1->SetBranchAddress("D0_PY_TRUE",&D0_PY_TRUE);
    t1->SetBranchAddress("D0_PZ_TRUE",&D0_PZ_TRUE);
    t1->SetBranchAddress("D0_E_TRUE",&D0_E_TRUE);      
    t1->SetBranchAddress("D0B_PX_TRUE",&D0B_PX_TRUE);
    t1->SetBranchAddress("D0B_PY_TRUE",&D0B_PY_TRUE);
    t1->SetBranchAddress("D0B_PZ_TRUE",&D0B_PZ_TRUE);
    t1->SetBranchAddress("D0B_E_TRUE",&D0B_E_TRUE);
    t1->SetBranchAddress("gamma_PX_TRUE",&gamma_PX_TRUE);
    t1->SetBranchAddress("gamma_PY_TRUE",&gamma_PY_TRUE);
    t1->SetBranchAddress("gamma_PZ_TRUE",&gamma_PZ_TRUE);
    t1->SetBranchAddress("gamma_E_TRUE",&gamma_E_TRUE);      

    Double_t D0_origX;
    Double_t D0_origY;
    Double_t D0_origZ;
    Double_t D0B_origX;
    Double_t D0B_origY;
    Double_t D0B_origZ;
    Double_t D0_vtxX;
    Double_t D0_vtxY;
    Double_t D0_vtxZ;
    Double_t D0B_vtxX;
    Double_t D0B_vtxY;
    Double_t D0B_vtxZ;

    Double_t D0_origX_TRUE;
    Double_t D0_origY_TRUE;
    Double_t D0_origZ_TRUE;
    Double_t D0B_origX_TRUE;
    Double_t D0B_origY_TRUE;
    Double_t D0B_origZ_TRUE;
    Double_t D0_vtxX_TRUE;
    Double_t D0_vtxY_TRUE;
    Double_t D0_vtxZ_TRUE;
    Double_t D0B_vtxX_TRUE;
    Double_t D0B_vtxY_TRUE;
    Double_t D0B_vtxZ_TRUE;

    t1->SetBranchAddress("D0_vtxX_TRUE",&D0_vtxX_TRUE);
    t1->SetBranchAddress("D0_vtxY_TRUE",&D0_vtxY_TRUE);
    t1->SetBranchAddress("D0_vtxZ_TRUE",&D0_vtxZ_TRUE);
    t1->SetBranchAddress("D0_origX_TRUE",&D0_origX_TRUE);
    t1->SetBranchAddress("D0_origY_TRUE",&D0_origY_TRUE);
    t1->SetBranchAddress("D0_origZ_TRUE",&D0_origZ_TRUE);
    t1->SetBranchAddress("D0B_vtxX_TRUE",&D0B_vtxX_TRUE);
    t1->SetBranchAddress("D0B_vtxY_TRUE",&D0B_vtxY_TRUE);
    t1->SetBranchAddress("D0B_vtxZ_TRUE",&D0B_vtxZ_TRUE);
    t1->SetBranchAddress("D0B_origX_TRUE",&D0B_origX_TRUE);
    t1->SetBranchAddress("D0B_origY_TRUE",&D0B_origY_TRUE);
    t1->SetBranchAddress("D0B_origZ_TRUE",&D0B_origZ_TRUE);

    t1->SetBranchAddress("D0_vtxX",&D0_vtxX);
    t1->SetBranchAddress("D0_vtxY",&D0_vtxY);
    t1->SetBranchAddress("D0_vtxZ",&D0_vtxZ);
    t1->SetBranchAddress("D0_origX",&D0_origX);
    t1->SetBranchAddress("D0_origY",&D0_origY);
    t1->SetBranchAddress("D0_origZ",&D0_origZ);
    t1->SetBranchAddress("D0B_vtxX",&D0B_vtxX);
    t1->SetBranchAddress("D0B_vtxY",&D0B_vtxY);
    t1->SetBranchAddress("D0B_vtxZ",&D0B_vtxZ);
    t1->SetBranchAddress("D0B_origX",&D0B_origX);
    t1->SetBranchAddress("D0B_origY",&D0B_origY);
    t1->SetBranchAddress("D0B_origZ",&D0B_origZ);

    //read all entries and fill the histograms
    Long64_t nentries = t1->GetEntries();
    for (Long64_t i=0;i<nentries;i++) {
      t1->GetEntry(i);

      // B variables

      TLorentzVector bachKp(bachKp_PX,bachKp_PY,bachKp_PZ,bachKp_E);
      TLorentzVector bachKp_TRUE(bachKp_PX_TRUE,bachKp_PY_TRUE,bachKp_PZ_TRUE,bachKp_E_TRUE);

      TVector3 Bp_orig(Bp_origX,Bp_origY,Bp_origZ);
      TVector3 Bp_vtx(Bp_vtxX,Bp_vtxY,Bp_vtxZ);
      TVector3 Bp_orig_TRUE(Bp_origX_TRUE,Bp_origY_TRUE,Bp_origZ_TRUE);
      TVector3 Bp_vtx_TRUE(Bp_vtxX_TRUE,Bp_vtxY_TRUE,Bp_vtxZ_TRUE);
    
      TVector3 Bp3 = Bp_vtx - Bp_orig;
      TVector3 Bp3_T = Bp_vtx_TRUE - Bp_orig_TRUE;
    
      Bp_FD_CALC = Bp3.Mag();

      TVector3 unit_Bp3 = Bp3.Unit();
      TVector3 unit_Bp3_T = Bp3_T.Unit();

      // D variables

      TLorentzVector D0(D0_PX,D0_PY,D0_PZ,D0_E);
      TLorentzVector D0B(D0B_PX,D0B_PY,D0B_PZ,D0B_E);
//      TLorentzVector gamma(gamma_PX,gamma_PY,gamma_PZ,gamma_E);
      TLorentzVector D0_TRUE(D0_PX_TRUE,D0_PY_TRUE,D0_PZ_TRUE,D0_E_TRUE);
      TLorentzVector D0B_TRUE(D0B_PX_TRUE,D0B_PY_TRUE,D0B_PZ_TRUE,D0B_E_TRUE);
      TLorentzVector gamma_TRUE(gamma_PX_TRUE,gamma_PY_TRUE,gamma_PZ_TRUE,gamma_E_TRUE);

      TVector3 D0_orig(D0_origX,D0_origY,D0_origZ);
      TVector3 D0_vtx(D0_vtxX,D0_vtxY,D0_vtxZ);
      TVector3 D0B_orig(D0B_origX,D0B_origY,D0B_origZ);
      TVector3 D0B_vtx(D0B_vtxX,D0B_vtxY,D0B_vtxZ);
      TVector3 D0_orig_TRUE(D0_origX_TRUE,D0_origY_TRUE,D0_origZ_TRUE);
      TVector3 D0_vtx_TRUE(D0_vtxX_TRUE,D0_vtxY_TRUE,D0_vtxZ_TRUE);
      TVector3 D0B_orig_TRUE(D0B_origX_TRUE,D0B_origY_TRUE,D0B_origZ_TRUE);
      TVector3 D0B_vtx_TRUE(D0B_vtxX_TRUE,D0B_vtxY_TRUE,D0B_vtxZ_TRUE);
    
      TVector3 D03 = D0_vtx - D0_orig;
      TVector3 D0B3 = D0B_vtx - D0B_orig;
      TVector3 D03_T = D0_vtx_TRUE - D0_orig_TRUE;
      TVector3 D0B3_T = D0B_vtx_TRUE - D0B_orig_TRUE;
    
      D0_FD_CALC = D03.Mag();
      D0B_FD_CALC = D0B3.Mag();                                             

      TVector3 unit_D03 = D03.Unit();
      TVector3 unit_D0B3 = D0B3.Unit();
      TVector3 unit_D03_T = D03_T.Unit();
      TVector3 unit_D0B3_T = D0B3_T.Unit();

      // B variables

      TLorentzVector B_momS, B_momT;

      //load the true (inc. invisible) and smeared momenta
      B_momT = D0_TRUE + D0B_TRUE + gamma_TRUE + bachKp_TRUE;
      B_momS = D0 + D0B + bachKp;

      //get the sine and cosine of the angle to the B flight direction with a Gaussian smearing applied
      double B_cosDir = B_momT.Vect().Dot(B_momS.Vect())/(B_momT.P()*B_momS.P());
      double B_dir = TMath::ACos(B_cosDir) + gRandom->Gaus(0.,0.001); 
      double B_sinDir = TMath::Sin(B_dir);
      B_cosDir = TMath::Cos(B_dir);

      //get the longitudinal and transverse momentum of the visible daughters wrt the B flight direction
      double B_pLong = TMath::Abs(B_cosDir * B_momS.P());
      double B_pTran = TMath::Abs(B_sinDir * B_momS.P());

      //invariant masses of the visible daughters and the parent as well as the missing mass
      double B_mVis2 = B_momS.M2();
      //double B_mPar2 = B_momT.M2();
      //double B_mMiss2 = B_mPar2 - B_mVis2;

      //the corrected mass
      double B_mCorr = TMath::Sqrt( B_mVis2 + B_pTran*B_pTran ) + B_pTran;

      //the maximum missing mass under the B meson hypthesis
//      double B_m0maxsq = (B_momT.M())*(B_momT.M()) - 2*(B_momT.M())*sqrt(B_mVis2 + B_pTran*B_pTran) + B_mVis2; // can be affected by FSR     
      double Bp_mass_nominal = 5.27931; // in GeV
      double B_m0maxsq = (Bp_mass_nominal)*(Bp_mass_nominal) - 2*(Bp_mass_nominal)*sqrt(B_mVis2 + B_pTran*B_pTran) + B_mVis2; // can be affected by FSR     

      //prepare reconstructed B energy
      double B_m0sq = 0;
      if (B_m0maxsq >= 0) {B_m0sq = B_m0maxsq;} 
      double B_p0l = ((Bp_mass_nominal)*(Bp_mass_nominal) - (B_mVis2 + B_pTran*B_pTran) - (B_m0sq + B_pTran*B_pTran))*B_pLong/(2*(B_mVis2 + B_pTran*B_pTran));

      DDbK_pT_B_dir = B_pTran;
      B_msq_miss_max = B_m0maxsq;
      B_signed_m_miss_max = 0;
      if (B_msq_miss_max > 0) {B_signed_m_miss_max =  sqrt(( B_msq_miss_max));}
      if (B_msq_miss_max < 0) {B_signed_m_miss_max = -sqrt((-B_msq_miss_max));}
      B_confirm_Mcorr = B_mCorr;
      B_confirm_B_M_TRUE = B_momT.M(); // can be affected by FSR
      B_confirm_B_E_TRUE = B_momT.E(); // can be affected by FSR
      B_confirm_D0_D0B_Kp_M = B_momS.M();
      B_E_rec_B = sqrt(B_m0sq + B_pTran*B_pTran + B_p0l*B_p0l) + sqrt(B_momS.M2() + B_pTran*B_pTran + B_pLong*B_pLong); // reco B energy

      // Kaon flight direction trick (see 16 May 2020 notes)
      TLorentzVector momS, momT_K;

      // pick the Kaon as the directional
      //load the true K momenta direction, and the visibles
      momT_K = bachKp_TRUE;
      momS = D0 - D0B;

      //get the sine and cosine of the angle to the K flight direction with a Gaussian smearing applied
      double DDbK_K_cosDir = momT_K.Vect().Dot(B_momS.Vect())/(momT_K.P()*B_momS.P());
      double DDbK_K_dir = TMath::ACos(DDbK_K_cosDir) ; // + gRandom->Gaus(0.,0.001); 
      double DDbK_K_sinDir = TMath::Sin(DDbK_K_dir);
      DDbK_K_cosDir = TMath::Cos(DDbK_K_dir); // not used

      double DDb_K_cosDir = momT_K.Vect().Dot(momS.Vect())/(momT_K.P()*momS.P());
      double DDb_K_dir = TMath::ACos(DDb_K_cosDir) ; // + gRandom->Gaus(0.,0.001); 
      double DDb_K_sinDir = TMath::Sin(DDb_K_dir);
      DDb_K_cosDir = TMath::Cos(DDb_K_dir); // not used

      //get the transverse momentum of the visible daughters wrt the K flight direction
      DDbK_pT_K_dir = TMath::Abs(DDbK_K_sinDir * B_momS.P());
      DDb_pT_K_dir  = TMath::Abs(DDb_K_sinDir  * momS.P());

      // D variables

      //TLorentzVector momS;
      TLorentzVector momT_D, momT_D_bar;

      // pick one particle as the directional first, we pick the D
      //load the true D momenta (direction) and the visibles
      momT_D = D0_TRUE;
      momT_D_bar = D0B_TRUE;
      //momS = D0 + D0B;

      // trying to figure out the uncertainty on the angle
      TVector3 unit_momS = (momS.Vect()).Unit();
      delCosDir = (unit_D03).Dot(unit_momS) - unit_D03_T.Dot(unit_momS);
      delCosDir_bar = (unit_D0B3).Dot(unit_momS) - unit_D0B3_T.Dot(unit_momS);
      delDir = TMath::ACos((unit_D03).Dot(unit_momS)) - TMath::ACos(unit_D03_T.Dot(unit_momS));
      delDir_bar = TMath::ACos((unit_D0B3).Dot(unit_momS)) - TMath::ACos(unit_D0B3_T.Dot(unit_momS));

////// with original smearing
      //get the sine and cosine of the angle to the D flight direction with a Gaussian smearing applied
      double cosDir = momT_D.Vect().Dot(momS.Vect())/(momT_D.P()*momS.P());
      double dir = TMath::ACos(cosDir) + gRandom->Gaus(0.,0.001); 
      double sinDir = TMath::Sin(dir);
      cosDir = TMath::Cos(dir);

      double cosDir_bar = momT_D_bar.Vect().Dot(momS.Vect())/(momT_D_bar.P()*momS.P());
      double dir_bar = TMath::ACos(cosDir_bar) + gRandom->Gaus(0.,0.001); 
      double sinDir_bar = TMath::Sin(dir_bar);
      cosDir_bar = TMath::Cos(dir_bar);

      //get the longitudinal and transverse momentum of the visible daughters wrt the D flight direction
      double pLong = TMath::Abs(cosDir * momS.P());
      double pTran = TMath::Abs(sinDir * momS.P());
      double pLong_bar = TMath::Abs(cosDir_bar * momS.P());
      double pTran_bar = TMath::Abs(sinDir_bar * momS.P());

      pT_D_dir_orig = pTran;
      pT_D_dir_bar_orig = pTran_bar;
      max_pT_dir_orig = TMath::Max(pT_D_dir_orig,pT_D_dir_bar_orig);

      double D_Db_cosDir = momT_D_bar.Vect().Dot(D0.Vect())/(momT_D_bar.P()*D0.P());
      double D_Db_dir = TMath::ACos(D_Db_cosDir) + gRandom->Gaus(0.,0.001);
      double D_Db_sinDir = TMath::Sin(D_Db_dir);
      D_Db_cosDir = TMath::Cos(D_Db_dir); //not used

      double Db_D_cosDir = momT_D.Vect().Dot(D0B.Vect())/(momT_D.P()*D0B.P());
      double Db_D_dir = TMath::ACos(Db_D_cosDir) + gRandom->Gaus(0.,0.001);
      double Db_D_sinDir = TMath::Sin(Db_D_dir);
      Db_D_cosDir = TMath::Cos(Db_D_dir); //not used

      //get the longitudinal and transverse momentum of the visible daughters wrt the D flight direction
      double D_Db_pTran = TMath::Abs(D_Db_sinDir * D0.P());
      double Db_D_pTran = TMath::Abs(Db_D_sinDir * D0B.P());

      D_pT_Db_dir_orig = D_Db_pTran;
      Db_pT_D_dir_orig = Db_D_pTran;
      D_max_pT_dir_orig = TMath::Max(D_pT_Db_dir_orig,Db_pT_D_dir_orig);

/// // smearing .0003
      //get the sine and cosine of the angle to the D flight direction with a Gaussian smearing applied
      double dir_0003 = TMath::ACos(cosDir) + gRandom->Gaus(0.,0.0003); 
      double sinDir_0003 = TMath::Sin(dir_0003);
      double cosDir_0003 = TMath::Cos(dir_0003);

      double dir_bar_0003 = TMath::ACos(cosDir_bar) + gRandom->Gaus(0.,0.0003); 
      double sinDir_bar_0003 = TMath::Sin(dir_bar_0003);
      double cosDir_bar_0003 = TMath::Cos(dir_bar_0003);

      //get the longitudinal and transverse momentum of the visible daughters wrt the D flight direction
      pLong = TMath::Abs(cosDir_0003 * momS.P());
      pTran = TMath::Abs(sinDir_0003 * momS.P());
      pLong_bar = TMath::Abs(cosDir_bar_0003 * momS.P());
      pTran_bar = TMath::Abs(sinDir_bar_0003 * momS.P());

      pT_D_dir_orig_0003 = pTran;
      pT_D_dir_bar_orig_0003 = pTran_bar;
      max_pT_dir_orig_0003 = TMath::Max(pTran,pTran_bar);

/// // smearing .003
      //get the sine and cosine of the angle to the D flight direction with a Gaussian smearing applied
      double dir_003 = TMath::ACos(cosDir) + gRandom->Gaus(0.,0.003); 
      double sinDir_003 = TMath::Sin(dir_003);
      double cosDir_003 = TMath::Cos(dir_003);

      double dir_bar_003 = TMath::ACos(cosDir_bar) + gRandom->Gaus(0.,0.003); 
      double sinDir_bar_003 = TMath::Sin(dir_bar_003);
      double cosDir_bar_003 = TMath::Cos(dir_bar_003);

      //get the longitudinal and transverse momentum of the visible daughters wrt the D flight direction
      pLong = TMath::Abs(cosDir_003 * momS.P());
      pTran = TMath::Abs(sinDir_003 * momS.P());
      pLong_bar = TMath::Abs(cosDir_bar_003 * momS.P());
      pTran_bar = TMath::Abs(sinDir_bar_003 * momS.P());

      pT_D_dir_orig_003 = pTran;
      pT_D_dir_bar_orig_003 = pTran_bar;
      max_pT_dir_orig_003 = TMath::Max(pTran,pTran_bar);

/// // smearing .01
      //get the sine and cosine of the angle to the D flight direction with a Gaussian smearing applied
      double dir_01 = TMath::ACos(cosDir) + gRandom->Gaus(0.,0.01); 
      double sinDir_01 = TMath::Sin(dir_01);
      double cosDir_01 = TMath::Cos(dir_01);

      double dir_bar_01 = TMath::ACos(cosDir_bar) + gRandom->Gaus(0.,0.01); 
      double sinDir_bar_01 = TMath::Sin(dir_bar_01);
      double cosDir_bar_01 = TMath::Cos(dir_bar_01);

      //get the longitudinal and transverse momentum of the visible daughters wrt the D flight direction
      pLong = TMath::Abs(cosDir_01 * momS.P());
      pTran = TMath::Abs(sinDir_01 * momS.P());
      pLong_bar = TMath::Abs(cosDir_bar_01 * momS.P());
      pTran_bar = TMath::Abs(sinDir_bar_01 * momS.P());

      pT_D_dir_orig_01 = pTran;
      pT_D_dir_bar_orig_01 = pTran_bar;
      max_pT_dir_orig_01 = TMath::Max(pTran,pTran_bar);

/// // smearing .03
      //get the sine and cosine of the angle to the D flight direction with a Gaussian smearing applied
      double dir_03 = TMath::ACos(cosDir) + gRandom->Gaus(0.,0.03); 
      double sinDir_03 = TMath::Sin(dir_03);
      double cosDir_03 = TMath::Cos(dir_03);

      double dir_bar_03 = TMath::ACos(cosDir_bar) + gRandom->Gaus(0.,0.03); 
      double sinDir_bar_03 = TMath::Sin(dir_bar_03);
      double cosDir_bar_03 = TMath::Cos(dir_bar_03);

      //get the longitudinal and transverse momentum of the visible daughters wrt the D flight direction
      pLong = TMath::Abs(cosDir_03 * momS.P());
      pTran = TMath::Abs(sinDir_03 * momS.P());
      pLong_bar = TMath::Abs(cosDir_bar_03 * momS.P());
      pTran_bar = TMath::Abs(sinDir_bar_03 * momS.P());

      pT_D_dir_orig_03 = pTran;
      pT_D_dir_bar_orig_03 = pTran_bar;
      max_pT_dir_orig_03 = TMath::Max(pTran,pTran_bar);

      // Now using lab flight direction
      // Truth
//      TVector3 pLongVec = (unit_D03_T.Dot(momS.Vect())) * unit_D03_T;
//      TVector3 pLongVec_bar = (unit_D0B3_T.Dot(momS.Vect())) * unit_D0B3_T;
      // Lab
      TVector3 pLongVec = (unit_D03.Dot(momS.Vect())) * unit_D03;
      TVector3 pLongVec_bar = (unit_D0B3.Dot(momS.Vect())) * unit_D0B3;
      TVector3 pTranVec = momS.Vect() - pLongVec;
      TVector3 pTranVec_bar = momS.Vect() - pLongVec_bar;
      pLong = pLongVec.Mag();
      pTran = pTranVec.Mag();
      pLong_bar = pLongVec_bar.Mag();
      pTran_bar = pTranVec_bar.Mag();

      //invariant masses of the visible daughters //and the parent as well as the missing mass
      double mVis2 = momS.M2();
      //double mPar2 = momT_D.M2();
      //double mMiss2 = mPar2 - mVis2;

      //the corrected mass [start from X frame: M(X) = sqrt(mVis2 + pTran^2 + pLong^2) + sqrt(m0sq + pTran^2 + p0l^2)]
      //note that in the X frame, pLong^2 = p0l^2, but we don't know how to boost into this frame
      double mCorr = TMath::Sqrt( mVis2 + pTran*pTran ) + pTran; // lower bound on X mass, assuming photon is the light neutral
      double mCorr_bar = TMath::Sqrt( mVis2 + pTran_bar*pTran_bar ) + pTran_bar;

      //the maximum missing mass under the X(3872) meson hypthesis
//      double m0maxsq = (momT_D.M())*(momT_D.M()) - 2*(momT_D.M())*sqrt(mVis2 + pTran*pTran) + mVis2; // can be affected by FSR
      double mX_nominal = 3.87169; // in GeV
      double m0maxsq = (mX_nominal)*(mX_nominal) - 2*(mX_nominal)*sqrt(mVis2 + pTran*pTran) + mVis2; // can be affected by FSR
      double m0maxsq_bar = (mX_nominal)*(mX_nominal) - 2*(mX_nominal)*sqrt(mVis2 + pTran_bar*pTran_bar) + mVis2; // can be affected by FSR

      //prepare reconstructed X energy
      double m0sq = 0;
      if (m0maxsq >= 0) {m0sq = m0maxsq;} // because m0 is bounded by [0 , m0max]
      double p0l = ((mX_nominal)*(mX_nominal) - (mVis2 + pTran*pTran) - (m0sq + pTran*pTran))*pLong/(2*(mVis2 + pTran*pTran)); // Eq. (7.5) SLAC-R-550

      double m0sq_bar = 0;
      if (m0maxsq_bar >= 0) {m0sq_bar = m0maxsq_bar;}
      double p0l_bar = ((mX_nominal)*(mX_nominal) - (mVis2 + pTran_bar*pTran_bar) - (m0sq_bar + pTran_bar*pTran_bar))*pLong_bar/(2*(mVis2 + pTran_bar*pTran_bar));

      confirm_MCorr = mCorr;
      confirm_MCorr_bar = mCorr_bar;
      max_confirm_Mcorr = TMath::Max(confirm_MCorr,confirm_MCorr_bar);

      msq_miss_max = m0maxsq;
      msq_miss_max_bar = m0maxsq_bar;
      min_msq_miss_max = TMath::Min(msq_miss_max,msq_miss_max_bar); // minimum value of m0maxsq among that determined from D and Dbar
      theVariable = TMath::Min(msq_miss_max,msq_miss_max_bar); // minimum value of m0maxsq among that determined from D and Dbar
      msq_miss_max_avg = ( msq_miss_max + msq_miss_max_bar ) / 2; // average of msq_miss_max along D direction and along Dbar direction
      signed_m_miss_max_avg = 0;
      if (( msq_miss_max + msq_miss_max_bar )/2 > 0) {signed_m_miss_max_avg =  sqrt(( ( msq_miss_max + msq_miss_max_bar )/2));}
      if (( msq_miss_max + msq_miss_max_bar )/2 < 0) {signed_m_miss_max_avg = -sqrt((-( msq_miss_max + msq_miss_max_bar )/2));}

      pT_D_dir = pTran;
      pT_D_dir_bar = pTran_bar;
      max_pT_dir = TMath::Max(pT_D_dir,pT_D_dir_bar);

      E_rec_X = sqrt(m0sq + pTran*pTran + p0l*p0l) + sqrt(momS.M2() + pTran*pTran + pLong*pLong); // reco X energy, lab frame
      E_rec_X_bar = sqrt(m0sq_bar + pTran_bar*pTran_bar + p0l_bar*p0l_bar) + sqrt(momS.M2() + pTran_bar*pTran_bar + pLong_bar*pLong_bar); // reco X energy, lab frame

     //NEW IDEA
      //recall the corrected mass [start from X frame: M(X) = sqrt(mVis2 + pTran^2 + pLong^2) + sqrt(m0sq + pTran^2 + p0l^2)]
      //Basic 2 body scenario predicts, in the rest frame of the decaying particle:
      //p^2 = (m_X^2 - (mVis + m0)^2)  (m_X^2 - (mVis - m0)^2) / (4 m_X^2)
      //assume photon hypothesis
      Double_t mX_nominal_sq = (mX_nominal)*(mX_nominal);
      p_break_hypoG_sq = ( (mX_nominal_sq - mVis2) * (mX_nominal_sq - mVis2) ) / (4*mX_nominal_sq);
      p_break_hypoG = sqrt(p_break_hypoG_sq);
      Double_t m_piz_nominal = 0.134977;
      Double_t mVis = sqrt(mVis2);
      Double_t mVisplpi0 = mVis + m_piz_nominal;
      Double_t mVismipi0 = mVis - m_piz_nominal;
      p_break_hypoP_sq = ( (mX_nominal_sq - (mVisplpi0*mVisplpi0) ) * ( mX_nominal_sq - (mVismipi0*mVismipi0) ) ) / (4*mX_nominal_sq);
      p_break_hypoP = sqrt(p_break_hypoP_sq);

      // Better idea? (not sure I am doing this one right)
      //msq_miss_restX = 0 - (3*mVis2 + 4*pTran*pTran - mX_nominal_sq);
      msq_miss_restX = 0 - (mVis2 - mX_nominal_sq);

      ////////////////// FUZZ

      double cosDir_fuzz = momT_D.Vect().Dot(momS.Vect())/(momT_D.P()*momS.P());
      double dir_fuzz = TMath::ACos(cosDir_fuzz) + gRandom->Gaus(0.,0.001); 
      // double dir_fuzz = TMath::ACos(cosDir_fuzz) + gRandom->Gaus(0.,0.01); (10x RapidSim original) 
      double sinDir_fuzz = TMath::Sin(dir_fuzz);
      cosDir_fuzz = TMath::Cos(dir_fuzz);
      double pTran_fuzz = TMath::Abs(sinDir_fuzz * momS.P());
      double m0maxsq_fuzz = (mX_nominal)*(mX_nominal) - 2*(mX_nominal)*sqrt(mVis2 + pTran_fuzz*pTran_fuzz) + mVis2; // can be affected by FSR
      min_msq_miss_max_fuzz = m0maxsq_fuzz;
      theVariable_fuzz = m0maxsq_fuzz;

      //////////////////


      tf->Fill();
    }

  ff.cd();
  tf->Write();

}

