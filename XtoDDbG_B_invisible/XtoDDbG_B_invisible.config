# Setup where "X(3872)" decays to D0 D0B gamma decay, where D0 and D0B are presumed to be in a relative S-Wave. 
# In this case, the spin part in covariant tensor formalism is g^munu, i.e. equivalent to PHSP. 
# However, for us *PHSP is incorrect*. Because X(3872) is JPC = 1++, D0 and D0B should be in a relative P-wave.

geometry : LHCb
acceptance : AllIn
energy : 14
parent : b
useEvtGen : TRUE
evtGenUsePHOTOS : TRUE
#paramsDecaying : M, M2, MT, E, ET, P, PX, PY, PZ, PT, IP, SIGMAIP, MINIP, SIGMAMINIP, FD, eta, phi, y, gamma, beta, theta, costheta, Mcorr, ProbNNpi, ProbN$
#paramsStable : M, M2, MT, E, ET, P, PX, PY, PZ, PT, IP, SIGMAIP, MINIP, SIGMAMINIP, FD, eta, phi, y, gamma, beta, theta, costheta, Mcorr, ProbNNpi, ProbNNk
#paramsTwoBody : M, M2, MT, E, ET, P, PX, PY, PZ, PT, IP, SIGMAIP, MINIP, SIGMAMINIP, FD, eta, phi, y, gamma, beta, theta, costheta, Mcorr, ProbNNpi, ProbNNk
paramsDecaying : M, M2, MT, E, ET, P, PX, PY, PZ, PT, IP, SIGMAIP, MINIP, SIGMAMINIP, FD, eta, phi, y, gamma, beta, Mcorr, vtxX, vtxY, vtxZ, origX, origY, origZ
paramsStable : MT, E, ET, P, PX, PY, PZ, PT, IP, SIGMAIP, MINIP, SIGMAMINIP, eta, phi, y, gamma, beta, ProbNNpi, ProbNNk
paramsTwoBody : M, M2, MT, E, ET, P, PX, PY, PZ, PT, IP, SIGMAIP, MINIP, SIGMAMINIP, FD, eta, phi, y, gamma, beta, Mcorr

# X(3872) decay helicity angles [not useful if you can't see the gamma]
#param : D0_gamma_costheta_REST_D0_D0B costheta 3 4 3 5
#param : gamma_D0B_costheta_REST_D0_gamma costheta 4 5 3 4
#param : D0_D0B_costheta_REST_D0B_gamma costheta 3 5 5 4
#param : D0_gamma_costheta_REST_D0_D0B_TRUE costheta 3 4 3 5 TRUE
#param : gamma_D0B_costheta_REST_D0_gamma_TRUE costheta 4 5 3 4 TRUE
#param : D0_D0B_costheta_REST_D0B_gamma_TRUE costheta 3 5 5 4 TRUE

# separate X(3872) from psi(3770)
param : Km_D0B_costheta_REST_D0 costheta 6 5 6 7
param : Km_D0B_theta_REST_D0 theta 6 5 6 7
param : Kp_D0_costheta_REST_D0B costheta 8 3 8 9
param : Kp_D0_theta_REST_D0B theta 8 3 8 9
param : Km_D0B_costheta_REST_D0_TRUE costheta 6 5 6 7 TRUE
param : Km_D0B_theta_REST_D0_TRUE theta 6 5 6 7 TRUE
param : Kp_D0_costheta_REST_D0B_TRUE costheta 8 3 8 9 TRUE
param : Kp_D0_theta_REST_D0B_TRUE theta 8 3 8 9 TRUE

# DDbar angle in the X frame [not possible without the light neutral]
#param : D0_D0B_costheta_REST_X costheta 3 5 3 5 4
#param : D0_D0B_theta_REST_X theta 3 5 3 5 4
#param : D0_D0B_costheta_REST_X_TRUE costheta 3 5 3 5 4 TRUE
#param : D0_D0B_theta_REST_X_TRUE theta 3 5 3 5 4 TRUE

# real B helicity B -> X K [not possible without the light neutral]
#param : D0_bachKp_costheta_REST_X costheta 3 2 3 5 4
#param : D0_bachKp_theta_REST_X theta 3 2 3 5 4
#param : D0_bachKp_costheta_REST_X_TRUE costheta 3 2 3 5 4 TRUE
#param : D0_bachKp_theta_REST_X_TRUE theta 3 2 3 5 4 TRUE

# B helicity (to separate ?={X,psi} in B -> ? K )
param : D0_bachKp_costheta_REST_D0_D0B costheta 3 2 3 5
param : D0_bachKp_theta_REST_D0_D0B theta 3 2 3 5
param : D0_bachKp_costheta_REST_D0_D0B_TRUE costheta 3 2 3 5 TRUE
param : D0_bachKp_theta_REST_D0_D0B_TRUE theta 3 2 3 5 TRUE
        
# B+ -> { X_1(3872) -> {D0 -> K- pi+} gamma {D0b -> K+ pi-} } K+

@0
    name : Bp
    evtGenModel : SVS
@1
	name : X_3872
	evtGenModel : PHSP
@2
    name : bachKp
	smear : LHCbGeneric
	smear : LHCbGenericIP
@3
	name : D0
@4
	name : gamma
	smear : LHCbPhoton
        invisible: true
@5
	name : D0B
@6
    name : Km
	smear : LHCbGeneric        
	smear : LHCbGenericIP        
@7
    name : pip
	smear : LHCbGeneric
	smear : LHCbGenericIP
@8
    name : Kp
	smear : LHCbGeneric        
	smear : LHCbGenericIP
@9
    name : pim
	smear : LHCbGeneric
	smear : LHCbGenericIP
